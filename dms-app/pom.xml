<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.org.openygt</groupId>
        <artifactId>openygt-dms</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>dms-app</artifactId>
    <packaging>jar</packaging>
    <name>DMS Application</name>

    <dependencies>
        <dependency>
            <groupId>cn.org.openygt</groupId>
            <artifactId>dms-common</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.org.openygt</groupId>
            <artifactId>dms-masterdata</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.org.openygt</groupId>
            <artifactId>dms-system</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.org.openygt</groupId>
            <artifactId>dms-equipment</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.org.openygt</groupId>
            <artifactId>dms-production</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.org.openygt</groupId>
            <artifactId>dms-quality</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.org.openygt</groupId>
            <artifactId>dms-print</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.org.openygt</groupId>
            <artifactId>dms-analytics</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.org.openygt</groupId>
            <artifactId>dms-rbac</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>cn.org.openygt.DmsApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
