{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^ygt-(.*)": "@/components/ygt-$1/ygt-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/login/index",
      "style": {
        "navigationBarTitleText": "PDA 登录",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "工作台",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/task/scan",
      "style": {
        "navigationBarTitleText": "扫码查询"
      }
    },
    {
      "path": "pages/task/detail",
      "style": {
        "navigationBarTitleText": "任务详情"
      }
    },
    {
      "path": "pages/task/confirm",
      "style": {
        "navigationBarTitleText": "工序确认"
      }
    },
    {
      "path": "pages/photo/upload",
      "style": {
        "navigationBarTitleText": "拍照上传"
      }
    },
    {
      "path": "pages/log/list",
      "style": {
        "navigationBarTitleText": "操作日志"
      }
    },
    {
      "path": "pages/mine/index",
      "style": {
        "navigationBarTitleText": "我的",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/device/bind",
      "style": {
        "navigationBarTitleText": "设备绑定"
      }
    },
    {
      "path": "pages/handover/sign",
      "style": {
        "navigationBarTitleText": "交接签字"
      }
    },
    {
      "path": "pages/reprint/index",
      "style": {
        "navigationBarTitleText": "重打印"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "煎药管理 PDA",
    "navigationBarBackgroundColor": "#0066CC",
    "backgroundColor": "#FAFAFA",
    "navigationStyle": "default"
  },
  "tabBar": {
    "color": "#71717A",
    "selectedColor": "#0066CC",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "iconPath": "static/images/tabbar/home.png",
        "selectedIconPath": "static/images/tabbar/home-active.png",
        "text": "首页"
      },
      {
        "pagePath": "pages/task/scan",
        "iconPath": "static/images/tabbar/scan.png",
        "selectedIconPath": "static/images/tabbar/scan-active.png",
        "text": "扫码"
      },
      {
        "pagePath": "pages/log/list",
        "iconPath": "static/images/tabbar/log.png",
        "selectedIconPath": "static/images/tabbar/log-active.png",
        "text": "日志"
      },
      {
        "pagePath": "pages/mine/index",
        "iconPath": "static/images/tabbar/mine.png",
        "selectedIconPath": "static/images/tabbar/mine-active.png",
        "text": "我的"
      }
    ]
  }
}
