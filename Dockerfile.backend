# ============================================================
# 后端 Dockerfile — Spring Boot 2.7.18 + Java 8
# 构建产物：dms-app/target/*.jar
# ============================================================

# ---------- 构建阶段 ----------
FROM maven:3.9.6-eclipse-temurin-8 AS builder

WORKDIR /app

# 先复制所有 pom.xml，利用 Docker 缓存层下载依赖
COPY pom.xml .
COPY dms-analytics/pom.xml dms-analytics/
COPY dms-app/pom.xml dms-app/
COPY dms-common/pom.xml dms-common/
COPY dms-equipment/pom.xml dms-equipment/
COPY dms-inventory/pom.xml dms-inventory/
COPY dms-iot-gateway/pom.xml dms-iot-gateway/
COPY dms-masterdata/pom.xml dms-masterdata/
COPY dms-pda/pom.xml dms-pda/
COPY dms-print/pom.xml dms-print/
COPY dms-production/pom.xml dms-production/
COPY dms-quality/pom.xml dms-quality/
COPY dms-rbac/pom.xml dms-rbac/
COPY dms-system/pom.xml dms-system/

# 下载依赖（缓存层）
RUN mvn dependency:go-offline -B -q

# 复制完整源码
COPY . .

# 打包（跳过测试）
RUN mvn clean package -DskipTests -B -q

# ---------- 运行阶段 ----------
FROM eclipse-temurin:8-jre-alpine

LABEL maintainer="openygt"
LABEL description="OpenYGT Decoction Management System - Backend"

WORKDIR /app

# 复制构建产物
COPY --from=builder /app/dms-app/target/*.jar app.jar

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:9092/actuator/health || exit 1

EXPOSE 9092

ENTRYPOINT ["java", "-jar", "app.jar"]
